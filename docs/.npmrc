# The public registry, whatever a user's ~/.npmrc names: the lockfile resolves there.
registry=https://registry.npmjs.org/
# Fail-closed install policy: no lifecycle scripts run during install.
# esbuild/rollup binaries arrive via optionalDependencies and work without
# their postinstall validators. If a future dependency genuinely needs an
# install script, the build breaks visibly here instead of silently
# executing scripts; whitelist deliberately in that case.
ignore-scripts=true
